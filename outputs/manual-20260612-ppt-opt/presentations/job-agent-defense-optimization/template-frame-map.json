      "editTargets": [
        {
          "action": "rewrite",
          "sourceElementId": "sh/onyd0z61",
          "sourceText": "03 核心技术原理 (3) - 知识蒸馏",
          "contentIndex": 0
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/d8v6psfi",
          "sourceText": "核心思想：用高精度教师模型指导轻量学生模型，在保留识别能力的同时降低端侧推理开销。",
          "contentIndex": 1
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/6hcrmhk3",
          "sourceText": "一、蒸馏动机 | 教师 MRGCN-DANN 图结构表达强，但端侧推理开销较高。 | 学生采用 MLP / CNN1D，去除复杂图卷积，更适合 ARM64 与 NCNN 部署。",
          "contentIndex": 2
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/z25kb6xk",
          "sourceText": "二、训练设计 | 冻结教师模型，以 soft logits 作为知识指导。 | 学生同时学习硬标签 CE 与软标签 KL，兼顾分类正确性和知识迁移。",
          "contentIndex": 3
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/oj2t83it",
          "sourceText": "三、核心优势 | 继承教师模型的类别边界与泛化知识，降低轻量化精度损失。 | 学生模型参数更少、计算更轻，便于 ONNX / NCNN / INT8 部署。",
          "contentIndex": 4
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/d4vmtwra",
          "sourceText": "四、创新点与端侧价值 | 将知识蒸馏与 DANN 域自适应结合，同时关注情绪判别与域偏移抑制。 | 在识别精度、跨 trial 泛化能力和端侧效率之间建立平衡。",
          "contentIndex": 5
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/h4byhgn2",
          "sourceText": "联合损失：L = CE(y, p_s) + α·KL(p_t / T, p_s / T) + λ·L_domain",
          "contentIndex": 6
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/sji5snel",
          "sourceText": "最终目标：以“高精度教师 + 轻量学生 + 域约束蒸馏”实现精度、泛化能力与端侧效率的平衡。",
          "contentIndex": 7
        }
      ]
    },
