        {
          "action": "rewrite",
          "sourceElementId": "sh/87ed8bat",
          "sourceText": "01 研究背景与意义",
          "contentIndex": 0
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/fmlkjm1c",
          "sourceText": "核心价值",
          "contentIndex": 1
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/8jqh0fep",
          "sourceText": "随着脑机接口(BCI)、情绪健康监测和边缘智能设备的发展，基于脑电(EEG)信号的情绪识别，能够突破传统接触式与非接触式识别的局限，具备重要的科研价值与广泛的现实应用前景。",
          "contentIndex": 2
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/8bat47y1",
          "sourceText": "EEG 信号优势",
          "contentIndex": 3
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/jqh0fepk",
          "sourceText": "• 直接性：绕过人的主观意识表达，直接反映大脑皮层神经电生理活动，是情绪状态最底层的生理信号之一。 | • 抗伪装性：相比面部表情、语音语调等外部行为信号，极难被主观伪装或刻意掩饰。",
          "contentIndex": 4
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/8nqxs72x",
          "sourceText": "面临的技术挑战",
          "contentIndex": 5
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/j2t83itg",
          "sourceText": "• 信号特征复杂：高维度、多通道且极易受眼电、肌电等生理噪声干扰。 | • 泛化性瓶颈：个体间生理差异与跨时段状态变化，导致“域偏移”问题，严重影响模型跨被试识别效果。",
          "contentIndex": 6
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/crmhk3q5",
          "sourceText": "本项目核心目标",
          "contentIndex": 7
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/sfil0rqd",
          "sourceText": "面向 CPU/ARM64 边缘计算平台，构建“数据处理→特征增强→泛化优化→端侧推理”的全链路技术方案，攻克跨被试识别难题，实现一套高效、高精度、低功耗且可落地的 EEG 情绪识别系统。",
          "contentIndex": 8
        }
      ]
    },
    {
      "outputSlide": 5,
      "sourceSlide": 5,
      "narrativeRole": "challenges and innovations",
      "reuseMode": "duplicate-slide",
      "editTargets": [
        {
          "action": "rewrite",
          "sourceElementId": "sh/dg7adsji",
          "sourceText": "02 技术难点与主要创新",
          "contentIndex": 0
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/z25kb6xk",
          "sourceText": "▌ 三大技术难点",
          "contentIndex": 1
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/6dcbulwv",
          "sourceText": "图结构与推理效率的矛盾 | MRGCN模型表达能力强，但计算复杂度高，在端侧CPU上推理效率是巨大挑战。",
          "contentIndex": 2
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/y90je9cv",
          "sourceText": "跨实验泛化与域偏移 | EEG信号受个体状态影响大，模型易学习到与情绪无关的“域特征”，导致测试准确率下降。",
          "contentIndex": 3
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/n29gr2p8",
          "sourceText": "端侧部署链路复杂 | 从Python训练环境到ARM64 CPU的C++推理环境，涉及模型转换、量化、算子兼容性等复杂问题。",
          "contentIndex": 4
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/58z25kb6",
          "sourceText": "▌ 四大核心创新",
          "contentIndex": 5
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/ytsvu9kn",
          "sourceText": "增强动态信息表达 | 结合滑动窗口多频带特征与图结构建模，让模型感知短时动态信息。",
          "contentIndex": 6
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/k3q5o7qp",
          "sourceText": "融合脑网络构建 | 融合短距离空间连接、功能连接和可学习邻接矩阵，更精准刻画脑区协同关系。",
          "contentIndex": 7
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/val87ed8",
          "sourceText": "提升泛化稳定性 | 引入领域自适应(DANN)与自适应调参策略，提升模型在不同数据分布下的鲁棒性。",
          "contentIndex": 8
        },
        {
          "action": "rewrite",
          "sourceElementId": "sh/2lszqtcj",
          "sourceText": "构建完整工程闭环 | 建立从模型训练到端侧部署的完整流程，实现算法到产品的落地验证。",
          "contentIndex": 9
        }
      ]
    },
    {
