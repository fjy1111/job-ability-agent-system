# Database and LLM values are examples only. Never commit real secrets.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/job_ability
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-model-name

# User-selectable model providers. The settings page stores only the provider key.
DEFAULT_LLM_PROVIDER=deepseek

# ChatGPT 5.5 is the UI label. Set CHATGPT_MODEL to the exact model ID supported by your API channel.
CHATGPT_API_KEY=replace-with-chatgpt-key
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=replace-with-exact-chatgpt-model-id

# Gemini through its OpenAI-compatible endpoint.
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=replace-with-exact-gemini-model-id

# DeepSeek remains compatible with the project's existing LLM_* variables.
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generate a long random value for production and keep it outside source control.
SESSION_SECRET_KEY=replace-with-at-least-48-random-characters

# Production HTTPS protection. Keep false only for local http://127.0.0.1 development.
SESSION_HTTPS_ONLY=false
ENFORCE_HTTPS=false

# Institution authorization for the tri-party collaboration workspace.
SCHOOL_ROLE_ACCESS_CODE=replace-with-school-access-code
ENTERPRISE_ROLE_ACCESS_CODE=replace-with-enterprise-access-code

# Identity switching is disabled by default. Enable only for controlled demonstrations.
ALLOW_TRIPARTY_ROLE_SWITCH=false
